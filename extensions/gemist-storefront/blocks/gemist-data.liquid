{% render 'gemist-card', product: block.settings.product, block: block %}

{% schema %}
{
  "name": "Data card",
  "target": "section",
  "class": "gemist-data-block",
  "stylesheet": "gemist-storefront.css",
  "javascript": "gemist-storefront.js",
  "enabled_on": {
    "templates": ["product", "collection", "index", "page"]
  },
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "autofill": true
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline override",
      "info": "Leave blank to use Gemist product data."
    },
    {
      "type": "textarea",
      "id": "summary",
      "label": "Summary override"
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show badge",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_empty_state",
      "label": "Show placeholder when data is missing",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Stats layout",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "stacked", "label": "Stacked" },
        { "value": "inline", "label": "Inline" }
      ],
      "default": "grid"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Corner radius",
      "default": 16
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#1f6feb"
    }
  ]
}
{% endschema %}
